<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No REQUEST_INSTALL_PACKAGES here, deliberately.

      Updating moved to its own app. This one runs an accessibility service, and an app
      that can both choose what to install and tap "Install" is a malware primitive
      whatever the intent. Keeping the two apart means no component on the device has both.
    -->

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroPilotDemo">

        <activity
            android:name=".InspectorActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the inspector hand the trace file to another app through the share sheet.
             A file:// Uri would throw FileUriExposedException on API 24 and above. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.traces"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
