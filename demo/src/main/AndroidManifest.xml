<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared here, by the app, not by :andropilot-devtools. The library leaves this to the
      consumer on purpose so no app inherits an install permission it did not ask for.

      It lets the inspector hand a downloaded APK to the system installer, which then shows
      its own confirmation. Nothing here installs silently, and nothing automates that
      dialog. This app also runs an accessibility service, and a component that can both
      choose what to install and tap "Install" would be a malware primitive.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroPilotDemo">

        <activity
            android:name=".InspectorActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the inspector hand the trace file to another app through the share sheet.
             A file:// Uri would throw FileUriExposedException on API 24 and above. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.traces"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
